# Copy to .env and fill in before running the app. Never commit .env.

# MySQL connection string used by Drizzle migrations and the server.
DATABASE_URL=mysql://aspire:change-me@127.0.0.1:3306/aspire

# At least 32 random characters. Required in production; sessions are invalidated if it changes.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Private folder for uploaded documents. Keep it outside anything the web server serves.
STORAGE_DIR=./storage

# Session cookie lifetime in days (default 7).
SESSION_DAYS=7

# HTTP port and runtime mode (default 3000 / development).
PORT=3000
NODE_ENV=development

# Set to true behind a trusted reverse proxy so client IPs are used for rate limits.
TRUST_PROXY=false

# First registrar: run `pnpm create:registrar` once, then delete the password from this file.
ASPIRE_REGISTRAR_PASSWORD=

# Integration tests only: a disposable MySQL database whose name contains "test".
# WARNING: the tests delete every table in this database.
TEST_DATABASE_URL=
