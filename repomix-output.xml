<file path="server/routers/auth.ts">
import { TRPCError } from "@trpc/server";
import { eq } from "drizzle-orm";
import { nanoid } from "nanoid";
import { z } from "zod";
import { auditEvents, users, type User } from "../../drizzle/schema";
import { endSession, startSession } from "../_core/auth";
import { protectedProcedure, publicProcedure, router } from "../_core/trpc";
import { getDb, getUserByEmail, getUserById } from "../db";
import { DUMMY_HASH, PASSWORD_MAX, hashPassword, passwordProblem, verifyPassword } from "../services/passwords";
import { RateLimiter } from "../services/rateLimit";
export const MAX_FAILED_LOGINS = 5;
export const LOCK_MINUTES = 15;
export const authLimits = {
  loginByIp: new RateLimiter(30, 15 * 60_000),
  registerByIp: new RateLimiter(10, 60 * 60_000),
};
export const resetAuthLimits = () => { authLimits.loginByIp.reset(); authLimits.registerByIp.reset(); };
export function publicUser(user: User) {
  return {
    id: user.id,
    name: user.name,
    email: user.email,
    role: user.role,
    aspireRole: user.aspireRole,
    facultyId: user.facultyId,
    mustChangePassword: user.mustChangePassword,
    lastSignedIn: user.lastSignedIn,
    createdAt: user.createdAt,
  };
}
const clientIp = (req: { ip?: string; socket?: { remoteAddress?: string } }) => req.ip ?? req.socket?.remoteAddress ?? "unknown";
const database = async () => {
  const db = await getDb();
  if (!db) throw new TRPCError({ code: "SERVICE_UNAVAILABLE", message: "The database is unavailable." });
  return db;
};
async function audit(actorUserId: number | null, action: string, userId: number, afterData?: Record<string, unknown>) {
  const db = await database();
  await db.insert(auditEvents).values({ actorUserId, action, entityType: "user", entityId: String(userId), reason: null, beforeData: null, afterData: afterData ?? null });
}
const email = z.string().trim().toLowerCase().email("Enter a valid email address.").max(320);
const refused = () => new TRPCError({ code: "UNAUTHORIZED", message: "Email or password is incorrect." });
const tooMany = (seconds: number) => new TRPCError({ code: "TOO_MANY_REQUESTS", message: `Too many attempts. Try again in ${Math.max(1, Math.ceil(seconds / 60))} minute(s).` });
export const authRouter = router({
  me: publicProcedure.query((opts) => (opts.ctx.user ? publicUser(opts.ctx.user) : null)),
  register: publicProcedure.input(z.object({
    name: z.string().trim().min(2, "Enter your full name.").max(255),
    email,
    password: z.string().max(PASSWORD_MAX),
  })).mutation(async ({ ctx, input }) => {
    const limit = authLimits.registerByIp.hit(clientIp(ctx.req));
    if (!limit.allowed) throw tooMany(limit.retryAfterSeconds);
    const problem = passwordProblem(input.password, { email: input.email, name: input.name });
    if (problem) throw new TRPCError({ code: "BAD_REQUEST", message: problem });
    if (await getUserByEmail(input.email)) throw new TRPCError({ code: "CONFLICT", message: "An account with this email already exists. Sign in instead." });
    const db = await database();
    let id: number;
    try {
      const result = await db.insert(users).values({
        openId: `local-${nanoid(20)}`,
        name: input.name,
        email: input.email,
        loginMethod: "password",
        role: "user",
        aspireRole: "applicant",
        passwordHash: await hashPassword(input.password),
        passwordChangedAt: new Date(),
        lastSignedIn: new Date(),
      });
      id = result[0].insertId;
    } catch (error) {
      const code = (error as { code?: string; cause?: { code?: string } });
      if (code.code === "ER_DUP_ENTRY" || code.cause?.code === "ER_DUP_ENTRY") throw new TRPCError({ code: "CONFLICT", message: "An account with this email already exists. Sign in instead." });
      throw error;
    }
    const user = (await getUserById(id))!;
    await audit(user.id, "account_registered", user.id);
    await startSession(ctx.req, ctx.res, user);
    return publicUser(user);
  }),
  login: publicProcedure.input(z.object({ email, password: z.string().min(1).max(PASSWORD_MAX) })).mutation(async ({ ctx, input }) => {
    const limit = authLimits.loginByIp.hit(clientIp(ctx.req));
    if (!limit.allowed) throw tooMany(limit.retryAfterSeconds);
    const user = await getUserByEmail(input.email);
    if (!user || !user.passwordHash || !user.isActive) {
      await verifyPassword(input.password, DUMMY_HASH);
      throw refused();
    }
    const now = new Date();
    if (user.lockedUntil && user.lockedUntil > now) throw tooMany((user.lockedUntil.getTime() - now.getTime()) / 1000);
    const db = await database();
    if (!(await verifyPassword(input.password, user.passwordHash))) {
      const failures = user.failedLoginCount + 1;
      if (failures >= MAX_FAILED_LOGINS) {
        await db.update(users).set({ failedLoginCount: 0, lockedUntil: new Date(now.getTime() + LOCK_MINUTES * 60_000) }).where(eq(users.id, user.id));
        await audit(null, "account_locked", user.id, { minutes: LOCK_MINUTES });
      } else {
        await db.update(users).set({ failedLoginCount: failures }).where(eq(users.id, user.id));
      }
      throw refused();
    }
    await db.update(users).set({ failedLoginCount: 0, lockedUntil: null, lastSignedIn: now }).where(eq(users.id, user.id));
    await audit(user.id, "signed_in", user.id);
    await startSession(ctx.req, ctx.res, user);
    return publicUser({ ...user, lastSignedIn: now });
  }),
  logout: publicProcedure.mutation(({ ctx }) => {
    endSession(ctx.req, ctx.res);
    return { success: true } as const;
  }),
  changePassword: protectedProcedure.input(z.object({
    currentPassword: z.string().min(1).max(PASSWORD_MAX),
    newPassword: z.string().max(PASSWORD_MAX),
  })).mutation(async ({ ctx, input }) => {
    const user = ctx.user!;
    if (!user.passwordHash || !(await verifyPassword(input.currentPassword, user.passwordHash))) throw new TRPCError({ code: "UNAUTHORIZED", message: "Your current password is incorrect." });
    if (input.newPassword === input.currentPassword) throw new TRPCError({ code: "BAD_REQUEST", message: "Choose a password you have not used just now." });
    const problem = passwordProblem(input.newPassword, { email: user.email, name: user.name });
    if (problem) throw new TRPCError({ code: "BAD_REQUEST", message: problem });
    const db = await database();
    await db.update(users).set({
      passwordHash: await hashPassword(input.newPassword),
      passwordChangedAt: new Date(),
      mustChangePassword: false,
      failedLoginCount: 0,
      lockedUntil: null,
      sessionVersion: user.sessionVersion + 1,
    }).where(eq(users.id, user.id));
    await audit(user.id, "password_changed", user.id);
    await startSession(ctx.req, ctx.res, (await getUserById(user.id))!);
    return { success: true } as const;
  }),
});
</file>

<file path="server/routes/documentFile.ts">
import { eq } from "drizzle-orm";
import type { Express } from "express";
import { applicantDocuments, auditEvents } from "../../drizzle/schema";
import { authenticateRequest } from "../_core/auth";
import { getDb } from "../db";
import { loadApplicationForActor } from "../services/applicationAccess";
import { fileStore } from "../storage";
const SERVED_TYPES = new Set(["application/pdf", "image/png", "image/jpeg"]);
export function registerDocumentRoutes(app: Express) {
  app.get("/api/documents/:id/file", async (req, res) => {
    const id = Number(req.params.id);
    if (!Number.isInteger(id) || id <= 0) return void res.status(404).json({ error: "Document not found." });
    try {
      const user = await authenticateRequest(req);
      if (!user) return void res.status(401).json({ error: "Sign in to view this document." });
      if (user.mustChangePassword) return void res.status(403).json({ error: "Choose your own password before continuing." });
      const db = await getDb();
      if (!db) return void res.status(503).json({ error: "The database is unavailable." });
      const document = (await db.select().from(applicantDocuments).where(eq(applicantDocuments.id, id)).limit(1))[0];
      if (!document?.storageKey) return void res.status(404).json({ error: "Document not found." });
      if (!(await loadApplicationForActor(db, document.applicationId, user))) return void res.status(404).json({ error: "Document not found." });
      const bytes = await fileStore.get(document.storageKey).catch(() => null);
      if (!bytes) return void res.status(404).json({ error: "Document not found." });
      await db.insert(auditEvents).values({ actorUserId: user.id, action: "document_viewed", entityType: "application", entityId: document.applicationId, reason: null, beforeData: null, afterData: { documentId: id, documentType: document.documentType } });
      const type = SERVED_TYPES.has(document.contentType ?? "") ? document.contentType! : "application/octet-stream";
      const filename = (document.fileName ?? `document-${id}`).replace(/[^\w.\- ]+/g, "_");
      res.setHeader("Content-Type", type);
      res.setHeader("Content-Length", String(bytes.byteLength));
      res.setHeader("Content-Disposition", `inline; filename="${filename}"`);
      res.setHeader("Cache-Control", "private, no-store");
      res.setHeader("X-Content-Type-Options", "nosniff");
      res.setHeader("Content-Security-Policy", "default-src 'none'");
      res.end(bytes);
    } catch (error) {
      console.error("[documents] serve failed:", error);
      res.status(500).json({ error: "The document could not be served." });
    }
  });
}
</file>

<file path="server/rules-engine/checks.ts">
import type { Applicant, Check, Rule } from "./types";
import {
  CREDIT_OR_BETTER, O_PASS, bestSittingCount, normSubject, principalPasses, subsidiaryPassCount,
} from "./grades";
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "es"}`;
function countCheck(rule: Rule, expected: number, actual: number, label: string, detail = ""): Check {
  return {
    ruleId: rule.id,
    type: rule.type,
    status: actual >= expected ? "PASS" : "FAIL",
    expected: `at least ${expected} ${label}`,
    actual: `${actual} ${label}${detail}`,
    gap: Math.max(0, expected - actual),
  };
}
export function evaluateRule(rule: Rule, a: Applicant): Check {
  switch (rule.type) {
    case "MIN_PRINCIPAL_PASSES": {
      const passes = principalPasses(a);
      if (rule.sameSitting) {
        const best = bestSittingCount(passes);
        return countCheck(rule, rule.count, best.count, "principal passes at one sitting",
          best.sitting ? ` (${best.sitting})` : "");
      }
      return countCheck(rule, rule.count, passes.length, "principal passes");
    }
    case "MIN_SUBSIDIARY_PASSES":
      return countCheck(rule, rule.count, subsidiaryPassCount(a), "subsidiary passes");
    case "MIN_UCE_PASSES": {
      const passes = a.uce.filter((r) => O_PASS.has(r.grade));
      if (rule.sameSitting) {
        const best = bestSittingCount(passes);
        return countCheck(rule, rule.count, best.count, "UCE passes at one sitting",
          best.sitting ? ` (${best.sitting})` : "");
      }
      return countCheck(rule, rule.count, passes.length, "UCE passes");
    }
    case "HAS_UCE_RESULTS":
      return {
        ruleId: rule.id, type: rule.type,
        status: a.uce.length > 0 ? "PASS" : "FAIL",
        expected: "UCE results", actual: a.uce.length > 0 ? "UCE results present" : "no UCE results",
      };
    case "QUALIFICATION_CLASS_AT_LEAST": {
      const q = a.qualifications.find((x) => x.type === rule.qualification);
      const base = { ruleId: rule.id, type: rule.type, expected: rule.label };
      if (!q) return { ...base, status: "FAIL", actual: `no ${rule.qualification.toLowerCase()} held` };
      if (!rule.accepted.includes(q.classification))
        return { ...base, status: "FAIL", actual: q.classification };
      if (rule.requireRelated) {
        if (q.relatedToProgramme === undefined)
          return { ...base, status: "REVIEW", actual: `${q.classification}; relevance to programme not yet judged` };
        if (!q.relatedToProgramme)
          return { ...base, status: "FAIL", actual: `${q.classification}; not in a related field` };
      }
      return { ...base, status: "PASS", actual: q.classification };
    }
    case "SUBJECTS_RELEVANT_TO_PROGRAMME":
      return {
        ruleId: rule.id, type: rule.type, status: "REVIEW",
        expected: "passes in subjects relevant to the programme",
        actual: "cannot be checked automatically: no subject list for this programme",
      };
    case "MATHS_CREDIT_REQUIREMENT": {
      const subMaths = a.uace.find((r) => r.level === "SUBSIDIARY" && normSubject(r.subject) === "sub-maths");
      const uceMaths = a.uce.find((r) => normSubject(r.subject) === "mathematics");
      const expected = "Credit or better in Sub-Maths (A-level) or Mathematics (UCE)";
      const ok = (subMaths && CREDIT_OR_BETTER.has(subMaths.grade)) || (uceMaths && CREDIT_OR_BETTER.has(uceMaths.grade));
      if (ok) return { ruleId: rule.id, type: rule.type, status: "PASS", expected, actual: "requirement met" };
      if (a.uce.length === 0 && !subMaths)
        return { ruleId: rule.id, type: rule.type, status: "REVIEW", expected, actual: "no UCE or Sub-Maths results to check" };
      return {
        ruleId: rule.id, type: rule.type, status: "FAIL", expected,
        actual: `Sub-Maths ${subMaths ? subMaths.grade : "not taken"}; UCE Mathematics ${uceMaths ? uceMaths.grade : "not taken"}`,
      };
    }
    case "OLEVEL_OVERALL_GRADE_NOT_IN": {
      const expected = `overall UCE grade not in ${rule.grades.join(", ")}`;
      if (a.uceOverallGrade === undefined)
        return { ruleId: rule.id, type: rule.type, status: "REVIEW", expected, actual: "overall UCE grade not recorded" };
      const bad = rule.grades.includes(a.uceOverallGrade.toUpperCase());
      return { ruleId: rule.id, type: rule.type, status: bad ? "FAIL" : "PASS", expected, actual: `overall grade ${a.uceOverallGrade}` };
    }
  }
}
</file>

<file path="server/rules-engine/compile.ts">
import type { Level, Route, Rule, RuleSet, Selector, Weighting, WeightVariant } from "./types";
import { CREDIT_CLASSES, HEAC_CLASSES } from "./grades";
interface RawRule { type: string; [k: string]: unknown }
interface RawRoute { id: string; rules: RawRule[] }
export interface RulesData {
  entry: { id: string; source: { document: string }; levels: Record<string, { routes: RawRoute[] }> };
  weightingSystem: {
    id: string; status: string; approval: string;
    category_weights: { essential: number; relevant: number; desirable: number };
    alevel_points: Record<string, number>;
    source: { title: string };
  };
  programmeWeights: { rules: RawWeightRule[] };
  mapping: { mapped: { id: string; umu_programme: string; level: string; rules: { rule: string; role: string }[] }[] };
}
interface RawWeightRule {
  id: string; programme: string;
  source: { institution: string; edition: string; section: string };
  essential?: Selector[]; relevant?: Selector[]; desirable?: string[];
  variants?: { id: string; essential: Selector[]; relevant: Selector[]; desirable: string[] }[];
  special_requirements: { type: string; text?: string }[];
}
export interface BuildOptions {
  requireUceForDegrees?: boolean;
}
const SUPPORTED_LEVELS: Level[] = ["bachelors", "diploma", "certificate", "higher_education_certificate"];
const DEFAULT_DOCUMENTS: Record<Level, { common: string[]; byRoute: Record<string, string[]> }> = {
  bachelors: { common: ["NATIONAL_ID"], byRoute: {
    UACE_DIRECT: ["UACE_RESULT_SLIP"], DIPLOMA: ["DIPLOMA_CERTIFICATE", "DIPLOMA_TRANSCRIPT"], HIGHER_EDUCATION_ACCESS: ["HEAC_CERTIFICATE"] } },
  diploma: { common: ["NATIONAL_ID"], byRoute: {
    UACE: ["UACE_RESULT_SLIP", "UCE_RESULT_SLIP"], CERTIFICATE_HOLDER: ["CERTIFICATE", "UCE_RESULT_SLIP"] } },
  certificate: { common: ["NATIONAL_ID"], byRoute: { UCE: ["UCE_RESULT_SLIP"] } },
  higher_education_certificate: { common: ["NATIONAL_ID"], byRoute: { UACE: ["UACE_RESULT_SLIP", "UCE_RESULT_SLIP"] } },
};
function translateRoute(raw: RawRoute): Route {
  const sameSittingFlag = raw.rules.some((r) => r.type === "SAME_SITTING");
  const rules: Rule[] = [];
  raw.rules.forEach((r, i) => {
    const id = `${raw.id}:${r.type}:${i}`;
    switch (r.type) {
      case "SAME_SITTING": return;
      case "MIN_PRINCIPAL_PASSES":
        rules.push({ id, type: r.type, count: r["count"] as number, sameSitting: sameSittingFlag }); return;
      case "MIN_SUBSIDIARY_PASSES":
        rules.push({ id, type: r.type, count: r["count"] as number }); return;
      case "MIN_UCE_PASSES":
        rules.push({ id, type: r.type, count: r["count"] as number, sameSitting: r["same_sitting"] === true }); return;
      case "UCE_OR_EQUIVALENT":
        rules.push({ id, type: "HAS_UCE_RESULTS" }); return;
      case "SUBJECTS_RELEVANT_TO_PROGRAMME":
        rules.push({ id, type: r.type }); return;
      case "DIPLOMA_CLASS_AT_LEAST":
        rules.push({ id, type: "QUALIFICATION_CLASS_AT_LEAST", qualification: "DIPLOMA", accepted: CREDIT_CLASSES,
          label: String(r["min"]), requireRelated: false }); return;
      case "CERTIFICATE_CLASS_AT_LEAST":
        rules.push({ id, type: "QUALIFICATION_CLASS_AT_LEAST", qualification: "CERTIFICATE", accepted: CREDIT_CLASSES,
          label: `${String(r["min"])} in a related field`, requireRelated: true }); return;
      case "HEAC_GRADE_AT_LEAST":
        rules.push({ id, type: "QUALIFICATION_CLASS_AT_LEAST", qualification: "HEAC", accepted: HEAC_CLASSES,
          label: String(r["min"]), requireRelated: false }); return;
      default:
        throw new Error(`Unsupported rule type in route ${raw.id}: ${r.type}`);
    }
  });
  return { id: raw.id, rules };
}
export function buildRuleSet(
  data: RulesData,
  args: { programmeId: string; programmeName?: string; level?: Level; options?: BuildOptions },
): RuleSet {
  const options = args.options ?? {};
  const mapped = data.mapping.mapped.find((m) => m.id === args.programmeId);
  const name = mapped?.umu_programme ?? args.programmeName;
  const level = (mapped?.level ?? args.level) as Level | undefined;
  if (!name || !level) throw new Error(`Unknown programme "${args.programmeId}": pass programmeName and level`);
  if (!SUPPORTED_LEVELS.includes(level))
    throw new Error(`Level "${level}" is not supported yet (postgraduate screening is out of scope for v1)`);
  const rawLevel = data.entry.levels[level];
  if (!rawLevel) throw new Error(`No entry requirements for level "${level}"`);
  const routes = rawLevel.routes.map(translateRoute);
  const notes: string[] = [
    "Required documents are an assumed default; UMU has not published a document list.",
  ];
  const documents = structuredClone(DEFAULT_DOCUMENTS[level]);
  const primary = mapped?.rules.find((r) => r.role === "primary");
  const weightRule = primary ? data.programmeWeights.rules.find((w) => w.id === primary.rule) : undefined;
  const uaceDirect = routes.find((r) => r.id === "UACE_DIRECT");
  if (weightRule) {
    for (const s of weightRule.special_requirements) {
      if (s.type === "MATHS_CREDIT_REQUIREMENT" && uaceDirect)
        uaceDirect.rules.push({ id: `UACE_DIRECT:MATHS_CREDIT_REQUIREMENT:programme`, type: "MATHS_CREDIT_REQUIREMENT" });
      else if (s.type === "PRE_ENTRY_EXAM")
        notes.push(`Not enforced: ${s.text ?? "pre-entry examination"}`);
    }
    const sourceNote = weightRule.source.institution + " " + weightRule.source.edition;
    if (weightRule.source.edition !== "2026/2027") notes.push(`Weights from an older edition: ${sourceNote}`);
  }
  if (options.requireUceForDegrees && level === "bachelors" && uaceDirect) {
    uaceDirect.rules.push(
      { id: "UACE_DIRECT:MIN_UCE_PASSES:adopted", type: "MIN_UCE_PASSES", count: 5, sameSitting: true },
      { id: "UACE_DIRECT:OLEVEL_OVERALL_GRADE_NOT_IN:adopted", type: "OLEVEL_OVERALL_GRADE_NOT_IN", grades: ["7", "9", "X", "Y", "Z"] },
    );
    documents.byRoute["UACE_DIRECT"] = [...(documents.byRoute["UACE_DIRECT"] ?? []), "UCE_RESULT_SLIP"];
    notes.push("Adopted (not in UMU brochure): 5 UCE passes at one sitting and overall UCE grade exclusions for degrees.");
  }
  let weighting: Weighting | undefined;
  if (weightRule) {
    const variants: WeightVariant[] = weightRule.variants
      ? weightRule.variants
      : [{ id: "default", essential: weightRule.essential ?? [], relevant: weightRule.relevant ?? [], desirable: weightRule.desirable ?? [] }];
    weighting = {
      ruleId: weightRule.id,
      system: { category_weights: data.weightingSystem.category_weights, alevel_points: data.weightingSystem.alevel_points },
      variants,
    };
  }
  const adopted = weightRule !== undefined;
  return {
    programmeId: args.programmeId,
    programmeName: name,
    level,
    meta: {
      id: `${args.programmeId}:${adopted ? weightRule!.id : data.entry.id}`,
      status: adopted ? "adopted-proxy" : "official",
      source: adopted
        ? `${data.entry.source.document}; ${data.weightingSystem.source.title} (${weightRule!.source.institution}, ${weightRule!.source.section})`
        : data.entry.source.document,
      edition: "2026/2027",
      approval: adopted ? data.weightingSystem.approval : "published by UMU",
    },
    routes,
    documents,
    ...(weighting ? { weighting } : {}),
    notes,
  };
}
