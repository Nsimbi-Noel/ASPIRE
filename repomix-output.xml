<file path="server/storage.ts">
import { randomBytes } from "node:crypto";
import { mkdir, readFile, rename, rm, writeFile } from "node:fs/promises";
import path from "node:path";
import { ENV } from "./_core/env";
const KEY = /^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$/;
export class LocalFileStore {
  private readonly root: string;
  constructor(root: string) { this.root = path.resolve(root); }
  private locate(key: string): string {
    if (!KEY.test(key) || key.includes("..") || key.includes("//") || key.endsWith("/")) throw new Error("Invalid storage key.");
    const target = path.resolve(this.root, key);
    if (!target.startsWith(this.root + path.sep)) throw new Error("Invalid storage key.");
    return target;
  }
  async put(key: string, data: Buffer): Promise<void> {
    const target = this.locate(key);
    await mkdir(path.dirname(target), { recursive: true, mode: 0o700 });
    const temporary = `${target}.${randomBytes(6).toString("hex")}.tmp`;
    await writeFile(temporary, data, { mode: 0o600, flag: "wx" });
    await rename(temporary, target);
  }
  get(key: string): Promise<Buffer> { return readFile(this.locate(key)); }
  async remove(key: string): Promise<void> { await rm(this.locate(key), { force: true }); }
}
export const fileStore = new LocalFileStore(ENV.storageDir);
</file>

