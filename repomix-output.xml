<file path="server/rules-engine/weighting.ts">
import type { Applicant, ScoreLine, Selector, SubjectList, UaceResult, WeightedScore, Weighting, WeightVariant } from "./types";
import { CREDIT_OR_BETTER, O_WEIGHT_TENTHS, PRINCIPAL_PASS, normSubject } from "./grades";
const MAX_WEIGHTED_PRINCIPALS = 3;
const MAX_ESSENTIAL = 2;
interface Candidate { r: UaceResult; points: number }
export function computeWeightedScore(a: Applicant, w: Weighting): WeightedScore {
  const results = w.variants.map((v) => scoreVariant(a, w, v));
  results.sort((x, y) => y.total - x.total);
  const best = results[0]!;
  if (w.variants.length > 1) best.warnings.push(`Best of ${w.variants.length} variants: ${best.variant}`);
  return best;
}
function scoreVariant(a: Applicant, w: Weighting, v: WeightVariant): WeightedScore {
  const { category_weights: cw, alevel_points: pts } = w.system;
  const warnings: string[] = [];
  const lines: ScoreLine[] = [];
  const used = new Set<string>();
  let essentialCount = 0;
  let weighted = 0;
  const principals: Candidate[] = a.uace
    .filter((r) => r.level === "PRINCIPAL")
    .map((r) => ({ r, points: pts[r.grade] ?? 0 }))
    .filter((c) => c.points > 0);
  const isPass = (c: Candidate) => PRINCIPAL_PASS.has(c.r.grade);
  const key = (c: Candidate) => normSubject(c.r.subject);
  const pool = (from: SubjectList, eligible: (c: Candidate) => boolean): Candidate[] => {
    let list = principals.filter((c) => !used.has(key(c)) && eligible(c));
    if (Array.isArray(from)) {
      const names = new Set(from.map(normSubject));
      list = list.filter((c) => names.has(key(c)));
    } else if (from === "REMAINING_EXCLUDING_FINE_ART") {
      list = list.filter((c) => key(c) !== "fine art");
    } else if (from === "ALL_ARTS_SUBJECTS") {
      warnings.push("ALL_ARTS_SUBJECTS treated as all remaining subjects: no arts subject list in the source");
    }
    return list.sort((x, y) => y.points - x.points || key(x).localeCompare(key(y)));
  };
  const take = (c: Candidate, category: "essential" | "relevant") => {
    used.add(key(c));
    weighted += 1;
    if (category === "essential") essentialCount += 1;
    const weight = cw[category];
    lines.push({ subject: c.r.subject, grade: c.r.grade, category, points: c.points, weight, contribution: c.points * weight });
  };
  for (const s of v.essential) {
    const room = Math.min(MAX_ESSENTIAL - essentialCount, MAX_WEIGHTED_PRINCIPALS - weighted);
    if (room <= 0) break;
    for (const c of pickFor(s, room, pool, isPass)) take(c, "essential");
  }
  for (const s of v.relevant) {
    const room = MAX_WEIGHTED_PRINCIPALS - weighted;
    if (room <= 0) break;
    for (const c of pickFor(s, room, pool, () => true)) take(c, "relevant");
  }
  const desirableNames = new Set(v.desirable.map(normSubject));
  let desirable = 0;
  for (const r of a.uace) {
    if (r.level === "SUBSIDIARY" && desirableNames.has(normSubject(r.subject)) && CREDIT_OR_BETTER.has(r.grade)) {
      desirable += 1;
      lines.push({ subject: r.subject, grade: r.grade, category: "desirable", points: 1, weight: cw.desirable, contribution: cw.desirable });
    }
  }
  const alevel = lines.filter((l) => l.category !== "desirable").reduce((s, l) => s + l.contribution, 0);
  const olevelTenths = a.uce.reduce((s, r) => s + (O_WEIGHT_TENTHS[r.grade] ?? 0), 0);
  const olevel = olevelTenths / 10;
  const total = Math.round((alevel + desirable * cw.desirable) * 10 + olevelTenths) / 10;
  return { total, alevel, desirable, olevel, variant: v.id, lines, warnings };
}
function pickFor(
  s: Selector,
  room: number,
  pool: (from: SubjectList, eligible: (c: Candidate) => boolean) => Candidate[],
  eligible: (c: Candidate) => boolean,
): Candidate[] {
  switch (s.type) {
    case "REQUIRED":
      return pool(s.subjects, eligible).slice(0, room);
    case "ANY_OR_BOTH":
      return pool(s.subjects, eligible).slice(0, Math.min(2, room));
    case "BEST_OF": {
      const n = s.n ?? s.n_max ?? 1;
      return pool(s.from, eligible).slice(0, Math.min(n, room));
    }
  }
}
</file>

<file path="server/scripts/createRegistrar.ts">
import "dotenv/config";
import { getDb } from "../db";
import { createRegistrar, resetPasswordFromCli } from "../services/bootstrap";
function ask(prompt: string): Promise<string> {
  return new Promise((resolve) => {
    const stdin = process.stdin;
    process.stdout.write(prompt);
    let typed = "";
    stdin.setRawMode?.(true);
    stdin.resume();
    stdin.setEncoding("utf8");
    const onData = (chunk: string) => {
      for (const char of chunk) {
        if (char === "\r" || char === "\n" || char === "\u0004") {
          stdin.setRawMode?.(false); stdin.pause(); stdin.off("data", onData); process.stdout.write("\n");
          return resolve(typed);
        }
        if (char === "\u0003") process.exit(1);
        typed = char === "\u007f" || char === "\b" ? typed.slice(0, -1) : typed + char;
      }
    };
    stdin.on("data", onData);
  });
}
async function main() {
  const args = process.argv.slice(2).filter((arg) => arg !== "--reset");
  const reset = process.argv.includes("--reset");
  const [first, second] = args;
  if (!first || (!reset && !second)) throw new Error('Usage: pnpm create:registrar "Full Name" name@example.org   (or: pnpm create:registrar name@example.org --reset)');
  let password = process.env.ASPIRE_REGISTRAR_PASSWORD ?? "";
  if (!password) {
    if (!process.stdin.isTTY) throw new Error("Set ASPIRE_REGISTRAR_PASSWORD, or run this in a terminal to type the password.");
    password = await ask("Password: ");
    if ((await ask("Repeat the password: ")) !== password) throw new Error("The passwords do not match.");
  }
  const db = await getDb();
  if (!db) throw new Error("DATABASE_URL is not set or the database cannot be reached.");
  if (reset) {
    await resetPasswordFromCli(db, first, password);
    console.log(`Password reset for ${first}. All of their sessions have ended.`);
  } else {
    const result = await createRegistrar(db, { name: first, email: second!, password });
    console.log(`Created registrar ${second} (id ${result.id})${result.owner ? " as the project owner" : ""}. You can sign in now.`);
  }
}
main().then(() => process.exit(0)).catch((error) => { console.error(error instanceof Error ? error.message : error); process.exit(1); });
</file>

<file path="server/services/access.ts">
import { and, eq, inArray, sql, type SQL } from "drizzle-orm";
import { applicationProgrammes, applications, committeeDecisions, screeningRuns } from "../../drizzle/schema";
export const ASPIRE_ROLES = ["applicant", "registrar", "faculty_administrator"] as const;
export type AspireRole = (typeof ASPIRE_ROLES)[number];
export const STAFF_ROLES: readonly AspireRole[] = ["faculty_administrator", "registrar"];
export interface ActorUser {
  id: number;
  role: string;
  aspireRole: string;
  facultyId?: string | null;
}
export function roleOf(user: Pick<ActorUser, "role" | "aspireRole">): AspireRole {
  if (user.role === "admin") return "registrar";
  return (ASPIRE_ROLES as readonly string[]).includes(user.aspireRole) ? (user.aspireRole as AspireRole) : "applicant";
}
export type Scope =
  | { kind: "all" }
  | { kind: "faculty"; facultyId: string }
  | { kind: "own"; userId: number }
  | { kind: "none" };
export function scopeOf(user: ActorUser): Scope {
  const role = roleOf(user);
  if (role === "registrar") return { kind: "all" };
  if (role === "faculty_administrator") return user.facultyId ? { kind: "faculty", facultyId: user.facultyId } : { kind: "none" };
  return { kind: "own", userId: user.id };
}
export function canSeeFaculty(scope: Scope, facultyId: string | null | undefined): boolean {
  if (scope.kind === "all") return true;
  if (scope.kind === "faculty") return !!facultyId && facultyId === scope.facultyId;
  return false;
}
export function validateRoleAssignment(input: { role: AspireRole; facultyId?: string | null }, facultyExists: boolean): string | null {
  if (input.role === "faculty_administrator") {
    if (!input.facultyId) return "A faculty administrator must be assigned to a faculty.";
    if (!facultyExists) return "That faculty does not exist.";
    return null;
  }
  if (input.facultyId) return "Only a faculty administrator belongs to a faculty.";
  return null;
}
type AuditLike = { actorUserId: number | null; action: string; afterData: unknown; beforeData?: unknown };
export function redactHistory<T extends AuditLike>(
  events: T[],
  scope: Scope,
  viewerId: number,
  facultyOfProgramme: (programmeId: string) => string | null | undefined,
): T[] {
  if (scope.kind === "all") return events;
  if (scope.kind === "own") {
    const internalActions = new Set(["screening_run", "screening_run_single"]);
    return events.filter((event) => event.actorUserId === viewerId && !internalActions.has(event.action));
  }
  if (scope.kind === "none") return [];
  const out: T[] = [];
  for (const event of events) {
    const after = (event.afterData ?? null) as Record<string, unknown> | null;
    const programmeId = typeof after?.programmeId === "string" ? after.programmeId : null;
    if (programmeId && facultyOfProgramme(programmeId) !== scope.facultyId) continue;
    if (after && "outcomes" in after) {
      const { outcomes: _outcomes, programmesScreened: _screened, ...rest } = after;
      out.push({ ...event, afterData: rest });
    } else out.push(event);
  }
  return out;
}
export function redactDecisionForApplicant<T extends { id: number; programmeId: string; decision: string; decidedAt: Date }>(row: T) {
  return { id: row.id, programmeId: row.programmeId, decision: row.decision, decidedAt: row.decidedAt };
}
type AnyDb = { select: (...args: any[]) => any };
export function applicationVisibility(db: AnyDb, scope: Scope): SQL | undefined {
  switch (scope.kind) {
    case "all":
      return undefined;
    case "own":
      return eq(applications.applicantUserId, scope.userId);
    case "faculty":
      return inArray(
        applications.id,
        db
          .select({ id: applicationProgrammes.applicationId })
          .from(applicationProgrammes)
          .where(and(eq(applicationProgrammes.facultyId, scope.facultyId), eq(applicationProgrammes.status, "submitted"))),
      );
    case "none":
      return sql`1 = 0`;
  }
}
export function runVisibility(scope: Scope): SQL | undefined {
  switch (scope.kind) {
    case "all":
    case "own":
      return undefined;
    case "faculty":
      return eq(screeningRuns.facultyId, scope.facultyId);
    case "none":
      return sql`1 = 0`;
  }
}
export function decisionVisibility(scope: Scope): SQL | undefined {
  switch (scope.kind) {
    case "all":
    case "own":
      return undefined;
    case "faculty":
      return eq(committeeDecisions.facultyId, scope.facultyId);
    case "none":
      return sql`1 = 0`;
